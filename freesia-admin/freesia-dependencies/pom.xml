<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.freesia</groupId>
  <artifactId>freesia-dependencies</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Freesia Dependencies</name>
  <description>Single source of dependency versions for Freesia Admin</description>

  <properties>
    <spring-boot.version>4.1.2</spring-boot.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <sa-token.version>1.46.0</sa-token.version>
    <mybatis-flex.version>1.11.8</mybatis-flex.version>
    <!-- Optional analytics drivers: versions are locked here, nothing depends on them by default. -->
    <duckdb.version>2.0.0.1</duckdb.version>
    <clickhouse-jdbc.version>0.11.2</clickhouse-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Declared first so its versions (PostgreSQL driver, Flyway, Caffeine, Jackson, Testcontainers) win. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-bom</artifactId>
        <version>${sa-token.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.mybatis-flex</groupId>
        <artifactId>mybatis-flex-spring-boot4-starter</artifactId>
        <version>${mybatis-flex.version}</version>
      </dependency>
      <dependency>
        <groupId>org.duckdb</groupId>
        <artifactId>duckdb_jdbc</artifactId>
        <version>${duckdb.version}</version>
      </dependency>
      <dependency>
        <groupId>com.clickhouse</groupId>
        <artifactId>clickhouse-jdbc</artifactId>
        <version>${clickhouse-jdbc.version}</version>
      </dependency>

      <dependency>
        <groupId>com.freesia</groupId>
        <artifactId>freesia-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.freesia</groupId>
        <artifactId>freesia-starter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.freesia</groupId>
        <artifactId>freesia-starter-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.freesia</groupId>
        <artifactId>freesia-starter-data</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
