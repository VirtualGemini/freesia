# 测试环境：docker compose --env-file docker.env up -d --build --wait
# 这些是可提交的测试样例，不要填写或提交真实部署秘密；环境变量优先于此文件。
COMPOSE_PROJECT_NAME=freesia-test # 用于隔离容器、网络和数据卷，已有数据时不要随意改名
SPRING_PROFILES_ACTIVE=test # 后端明确加载 application-test.yml
FREESIA_HTTP_BIND=127.0.0.1 # 仅本机访问；远程测试时按实际防火墙和入口配置修改
FREESIA_HTTP_PORT=18080 # 前端及 /api 的统一入口，不占用本地 Vite/Java 端口
FREESIA_DB_NAME=freesia
FREESIA_DB_USERNAME=freesia
FREESIA_DB_PASSWORD='freesia-test-only' # 仅测试样例，真实口令由部署环境覆盖
FREESIA_REDIS_PASSWORD='freesia-test-valkey-only' # 与后端及 Valkey 探针使用同一值
FREESIA_DB_LANGUAGE=zh # 空库可选 zh/en；启动和 bootstrap-admin 保持一致
FREESIA_PROXY_SUBNET=172.28.100.0/24 # 使用前先确认不与宿主机、VPN 或其他 Docker 网络冲突
FREESIA_PROXY_IP=172.28.100.10 # 必须位于上述网段，仅此 Nginx 地址被后端信任
