# 生产配置骨架：docker compose --env-file docker.prod.env up -d --build --wait
# 当前只验证配置，不执行生产部署；真实口令由部署环境注入，保持提交文件为空。
COMPOSE_PROJECT_NAME=freesia-prod # 独立于测试环境，禁止复用其容器、网络或数据卷
SPRING_PROFILES_ACTIVE=prod # 后端明确加载 application-prod.yml
FREESIA_HTTP_BIND=127.0.0.1 # 推荐由服务器 HTTPS 入口反向代理至此，不直接公开明文 HTTP
FREESIA_HTTP_PORT=18081 # 服务器 HTTPS 入口的上游端口，可按部署调整
FREESIA_DB_NAME=freesia
FREESIA_DB_USERNAME=freesia
# 部署前从受保护的环境注入专用口令；空值不能初始化 PostgreSQL 数据卷。
FREESIA_DB_PASSWORD=
# 部署前从受保护的环境注入专用口令；空值时 Valkey 启动检查失败，不回退无认证。
FREESIA_REDIS_PASSWORD=
FREESIA_DB_LANGUAGE=zh # 仅空库初始化前选择，已有数据库不可直接切换
FREESIA_PROXY_SUBNET=172.28.101.0/24 # 与测试网络分离，部署前确认无网段冲突
FREESIA_PROXY_IP=172.28.101.10 # 与网段及后端可信代理配置保持一致
